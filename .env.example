# x402 Service Provider — Environment Configuration
# ══════════════════════════════════════════════════════════════════

# Algorand wallet address receiving payments (your merchant address)
AVM_ADDRESS=YOUR_ALGORAND_WALLET_ADDRESS

# x402 Facilitator URL for payment verification
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Server port
PORT=4022

# Groq API key for AI-powered translation and compute endpoints
GROQ_API_KEY=your_groq_api_key_here
